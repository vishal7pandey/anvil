# Copy to .env (gitignored). Never commit real values.
# OPENAI_API_KEY: not here. scripts/up.ps1 reads it from Windows Credential Manager (target "forge").
ANVIL_MAIN_MODEL=openai/gpt-5
ANVIL_FAST_MODEL=openai/gpt-5-mini
# Context window of the models behind those aliases, in tokens (ANVIL-93). Optional: with it, the agent
# summarizes older messages at 85% of the window and keeps the last 10%; without it, at 170k tokens.
# Each compaction shows in the chat and in `python -m anvil.analyze <run_id>`.
ANVIL_CONTEXT_WINDOW=
LITELLM_MASTER_KEY=sk-anvil-local
POSTGRES_PASSWORD=anvil

# Local knowledge folder (Markdown pages per space, auto-indexed; default: kb/local/)
ANVIL_KNOWLEDGE_DIR=
# Comma-separated trusted domains for web_search on runs without a case (ANVIL-64)
# (e.g. docs.rtems.org,pubs.opengroup.org; inside a case, its [web] allow list decides)
ANVIL_WEB_ALLOWLIST=
# Host-side tools only. These never reach a sandbox container.
# Local offline demo ticketing (ANVIL-56): path containing todo/, in-progress/, done/
ANVIL_TICKETS_DIR=
# Control API demo auth token (leave empty for unauthenticated local demo)
ANVIL_DEMO_TOKEN=
GITHUB_TOKEN=
GITHUB_OWNER=vishal7pandey
ATLASSIAN_SITE=https://vishal7pandey.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
SONAR_HOST_URL=
SONAR_TOKEN=
